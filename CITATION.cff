    given-names: Marcin
    alias: MR73BIIO
repository-code: "https://github.com/MR73BIIO/voro-gis-qa"
license: MIT
version: "0.1"
date-released: "2026-10-02"
keywords:
  - GIS
  - data quality
  - quality assurance
  - geospatial
  - GeoPandas
  - Poland
  - PRG
  - TERYT
